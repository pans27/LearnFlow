NODE_ENV=development
PORT=3000
# Required in production, at least 32 characters. Development falls back to a local secret when omitted.
# JWT_SECRET=
DB_PORT=5432
DATABASE_URL=postgresql://learnflow:learnflow_dev@localhost:5432/learnflow?schema=learnflow
# Optional seed overrides; omit the password to generate a random temporary password.
# DEFAULT_ADMIN_EMAIL=admin@learnflow.local
# DEFAULT_ADMIN_PASSWORD=
# Shared private bucket. The IAM user needs s3:PutObject, s3:GetObject, and s3:DeleteObject on this bucket's objects.
# Copy the access key and secret into Backend/.env. Leave them empty here so they are not committed.
AWS_REGION=us-east-2
AWS_S3_BUCKET=learnflow-1724
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
